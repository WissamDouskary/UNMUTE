# ============================================================
# UNMUTE — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unmute
POSTGRES_USER=unmute
POSTGRES_PASSWORD=changeme_dev_only

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT secret — use a strong random string in production (min 64 chars)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-characters-long!!

# JWT token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# --- AI Providers ---
# Keys are read only from the environment and are never logged. Leave a key blank to use the
# offline mock for everything that provider would do; the app works without any keys.
#
# OpenAI powers embeddings (semantic search / RAG retrieval) and speech-to-text, and can also be
# the text model. Anthropic (Claude), when set, is preferred for summaries, task extraction,
# Ask UNMUTE answers and auto-tagging. Gemini (Google AI Studio) can cover text, embeddings and
# transcription on its own — with only GEMINI_API_KEY set, auto selects Gemini for all three.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Provider selection: auto (default) uses a real provider whenever its key is set.
# Setting one explicitly (e.g. AI_LLM_PROVIDER=gemini) fails startup if its key is missing.
# AI_LLM_PROVIDER=auto              # auto | anthropic | openai | gemini | mock
# AI_EMBEDDING_PROVIDER=auto        # auto | openai | gemini | mock
# AI_TRANSCRIPTION_PROVIDER=auto    # auto | openai | gemini | mock

# Models (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium           # low | medium | high
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # changing it re-embeds all notes on startup
# OPENAI_TRANSCRIPTION_MODEL=whisper-1            # or gpt-4o-transcribe / gpt-4o-mini-transcribe
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001     # requested at 1536 dims; changing it re-embeds all notes
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash     # native generateContent with inline audio (webm/mp3/wav)

# Auto-tagging of new notes and voice transcripts
# AI_AUTO_TAG_ENABLED=true

# --- Web App ---
VITE_API_BASE_URL=http://localhost:8080

# --- Mobile App ---
# For iOS Simulator on macOS: http://localhost:8080
# For physical iPhone: http://<YOUR_LAN_IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
