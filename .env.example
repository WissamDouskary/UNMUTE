# ============================================================
# UNMUTE — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unmute
POSTGRES_USER=unmute
POSTGRES_PASSWORD=changeme_dev_only

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT secret — use a strong random string in production (min 64 chars)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-characters-long!!

# JWT token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# --- AI Providers (Phase 3+) ---
# Leave blank to use the dev mock provider.
# AI_PROVIDER=openai
# AI_API_KEY=
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_API_KEY=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=

# --- Web App ---
VITE_API_BASE_URL=http://localhost:8080

# --- Mobile App ---
# For iOS Simulator on macOS: http://localhost:8080
# For physical iPhone: http://<YOUR_LAN_IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
